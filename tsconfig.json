{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["wxt/client", "vitest/globals", "chrome"]
  },
  "include": [
    "entrypoints/**/*",
    "components/**/*",
    "services/**/*",
    "shared/**/*",
    "db/**/*",
    "messaging/**/*",
    "platform/**/*",
    "usecases/**/*",
    "tests/**/*",
    "wxt.config.ts",
    "tailwind.config.ts"
  ]
}
